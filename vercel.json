{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "//": "Vercel's Angular preset expects `ng build` and dist/<project>/browser. This is an Nx workspace that prerenders to dist/apps/web/browser, so every setting is stated explicitly and the preset is switched off.",

  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/apps/web/browser",

  "cleanUrls": true,
  "trailingSlash": false,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "//": "hashed build assets never change under the same name",
      "source": "/(.*)\\.(js|css|woff2|svg|png|jpg|webp|avif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
