{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@akib/util": ["./libs/util/src/index.ts"],
      "@akib/content": ["./libs/content/src/index.ts"],
      "@akib/ui": ["./libs/ui/src/index.ts"],
      "@akib/models": ["./libs/models/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
